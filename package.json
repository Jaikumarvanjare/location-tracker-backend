{
  "name": "location-tracker-api",
  "version": "1.0.0",
  "description": "Location Tracker REST API — Fastify + PostgreSQL + TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "ts-node src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^8.4.0",
    "@fastify/postgres": "^5.2.2",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^1.10.2",
    "dotenv": "^16.4.5",
    "fastify": "^4.29.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "@types/pg": "^8.11.6",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
